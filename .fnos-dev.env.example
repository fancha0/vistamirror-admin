# Mac 连接飞牛所需参数
FNOS_SSH_TARGET=root@192.168.5.9
FNOS_SSH_PORT=22
FNOS_DEV_ROOT=/vol3/1000/docker/vistamirror-dev

# 飞牛开发容器端口；不会占用正式版的 8091/8099
FNOS_DEV_ADMIN_PORT=18091
FNOS_DEV_PLAYBACK_PORT=18099

# 飞牛宿主机上的测试媒体目录
FNOS_MEDIA_SOURCE=/vol3/1000/media/测试

# 开发容器连接现有 Emby
APP_EMBY_SERVER_URL=http://192.168.5.9:8096
APP_EMBY_API_KEY=

# 开发环境登录信息，请按需修改
APP_ADMIN_AUTH_ENABLED=1
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=admin123

# 只有测试远程 SSH 密码/私钥保存功能时才需要填写
APP_INFRA_MASTER_KEY=
VISTAMIRROR_PUBLIC_BASE_URL=
